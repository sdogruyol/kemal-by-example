<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Webhook inbox</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #f8fafc;
        color: #0f172a;
      }
      a { color: #1d4ed8; }
      header {
        background: #0f172a;
        color: #fff;
      }
      .nav {
        max-width: 960px;
        margin: 0 auto;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 28px 16px 48px;
      }
      .card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 18px;
      }
      .meta { color: #64748b; font-size: 0.9rem; }
      .stack > * + * { margin-top: 10px; }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        text-align: left;
        padding: 10px 8px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: top;
      }
      th { font-size: 0.85rem; color: #64748b; }
      pre, .pre {
        white-space: pre-wrap;
        word-break: break-word;
        font-family: ui-monospace, monospace;
        font-size: 0.85rem;
        background: #f1f5f9;
        padding: 12px;
        border-radius: 8px;
        margin: 0;
      }
      code { font-size: 0.9em; }
      .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .badge.ok { background: #dcfce7; color: #166534; }
      .badge.warn { background: #fef9c3; color: #854d0e; }
    </style>
  </head>
  <body>
    <header>
      <div class="nav">
        <strong>Webhook inbox</strong>
        <a href="/">Inbox</a>
      </div>
    </header>
    <main>
      <%= content %>
    </main>
  </body>
</html>
