<section class="card">
  <h1>Edit Short URL</h1>
  <p>Update the label or target URL for this short link.</p>

  <form class="stack" action="/links/<%= short_url.id %>" method="post">
    <div>
      <label for="title">Title</label>
      <input id="title" type="text" name="title" value="<%= short_url.title %>" placeholder="Optional label for this link">
    </div>

    <div>
      <label for="original_url">Original URL</label>
      <input id="original_url" type="url" name="original_url" value="<%= short_url.original_url %>" required>
    </div>

    <div class="actions">
      <button type="submit">Update short URL</button>
      <a class="button-link secondary" href="/links">Back to links</a>
    </div>
  </form>
</section>
