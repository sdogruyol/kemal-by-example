<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OAuth login</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #f1f5f9;
        color: #0f172a;
      }
      a { color: #1d4ed8; }
      header {
        background: #0f172a;
        color: #fff;
      }
      .nav {
        max-width: 720px;
        margin: 0 auto;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 32px 16px 48px;
      }
      .card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
      }
      .stack > * + * { margin-top: 16px; }
      .meta { color: #64748b; font-size: 0.95rem; }
      .error {
        background: #fee2e2;
        color: #991b1b;
        border-radius: 8px;
        padding: 12px 14px;
      }
      .github-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #24292f;
        color: #fff !important;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
      }
      .github-btn:hover { filter: brightness(1.08); }
      button {
        border: 0;
        border-radius: 8px;
        padding: 8px 14px;
        background: #64748b;
        color: #fff;
        font: inherit;
        cursor: pointer;
      }
      .profile {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .profile img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 1px solid #e2e8f0;
      }
      code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; }
    </style>
  </head>
  <body>
    <header>
      <div class="nav">
        <strong>OAuth login</strong>
        <% if current_user %>
          <form action="/logout" method="post">
            <button type="submit">Log out</button>
          </form>
        <% end %>
      </div>
    </header>
    <main>
      <%= content %>
    </main>
  </body>
</html>
