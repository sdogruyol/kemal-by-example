<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Real-time Dashboard</title>
    <style>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
      }

      main {
        max-width: 1120px;
        margin: 0 auto;
        padding: 32px 16px 48px;
      }

      .hero {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 24px;
      }

      .hero p {
        max-width: 720px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.25);
      }

      .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #facc15;
      }

      .status-dot.connected {
        background: #22c55e;
      }

      .status-dot.disconnected {
        background: #ef4444;
      }

      .metrics-grid,
      .charts-grid {
        display: grid;
        gap: 16px;
      }

      .metrics-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 20px;
      }

      .charts-grid {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .card {
        background: #111827;
        border: 1px solid #1f2937;
        border-radius: 20px;
        padding: 20px;
      }

      .metric-label,
      .meta {
        color: #94a3b8;
      }

      .metric-value {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 8px 0 0;
      }

      .chart-title {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 12px;
      }

      .chart-frame {
        width: 100%;
        height: 160px;
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(37, 99, 235, 0.14), rgba(15, 23, 42, 0.04));
      }

      .chart-line {
        fill: none;
        stroke-width: 3;
        stroke-linejoin: round;
        stroke-linecap: round;
      }

      .chart-line.cpu {
        stroke: #38bdf8;
      }

      .chart-line.memory {
        stroke: #f97316;
      }

      .chart-line.disk {
        stroke: #22c55e;
      }

      .chart-grid-line {
        stroke: rgba(148, 163, 184, 0.2);
        stroke-width: 1;
      }
    </style>
  </head>
  <body>
    <main>
      <%= content %>
    </main>
  </body>
</html>
