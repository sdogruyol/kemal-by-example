<section class="card">
  <h1 style="margin-top: 0;">GitHub OAuth with Kemal</h1>

  <% if error_message %>
    <div class="error"><%= error_message %></div>
  <% end %>

  <% if current_user %>
    <div class="profile">
      <% if !current_user.avatar_url.empty? %>
        <img src="<%= current_user.avatar_url %>" alt="">
      <% end %>
      <div class="stack">
        <p style="margin: 0;"><strong><%= current_user.name %></strong></p>
        <p class="meta" style="margin: 0;">GitHub <code>@<%= current_user.login %></code></p>
        <% if email = current_user.email %>
          <p class="meta" style="margin: 0;"><%= email %></p>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="meta">Sign in with your GitHub account. The app stores your GitHub id, login, name, avatar URL, and email (when available).</p>

    <% if oauth_ready %>
      <p>
        <a class="github-btn" href="/auth/github">Sign in with GitHub</a>
      </p>
    <% else %>
      <p class="meta">Configure a GitHub OAuth App and set environment variables:</p>
      <ul class="meta">
        <li><code>GITHUB_CLIENT_ID</code></li>
        <li><code>GITHUB_CLIENT_SECRET</code></li>
        <li>Optional: <code>OAUTH_REDIRECT_URI</code> (default <code>http://127.0.0.1:3000/auth/github/callback</code>)</li>
      </ul>
    <% end %>
  <% end %>
</section>
