<section class="hero">
  <h1>File Upload & Storage</h1>
  <p>Upload files with a multipart form, store metadata in SQLite, and serve the uploaded assets from Kemal's public folder.</p>
</section>

<% if notice %>
  <div class="notice"><%= notice %></div>
<% end %>

<% if error_message %>
  <div class="error"><%= error_message %></div>
<% end %>

<section class="card">
  <h2>Upload File</h2>
  <p class="meta">Allowed types: JPG, PNG, GIF, WEBP, PDF, TXT. Maximum size: 50 MB.</p>

  <form class="stack" action="/files/upload" method="post" enctype="multipart/form-data">
    <div>
      <label for="file">Choose file</label>
      <input id="file" type="file" name="file" required>
    </div>

    <div>
      <button type="submit">Upload file</button>
    </div>
  </form>
</section>

<section class="files-grid">
  <% if stored_files.empty? %>
    <article class="card">
      <h2>No files yet</h2>
      <p class="meta">Upload a file to start building a small file library.</p>
    </article>
  <% else %>
    <% stored_files.each do |stored_file| %>
      <article class="card">
        <% if stored_file.image? %>
          <img class="preview" src="<%= stored_file.public_path %>" alt="<%= stored_file.original_name %>">
        <% end %>

        <h2><%= stored_file.original_name %></h2>
        <p class="meta">Type: <%= stored_file.mime_type %></p>
        <p class="meta">Size: <%= stored_file.formatted_size %></p>
        <p class="meta">Uploaded: <%= stored_file.created_at %></p>

        <div class="actions">
          <a class="button-link" href="/files/<%= stored_file.id %>">Details</a>
          <a class="button-link secondary" href="<%= stored_file.public_path %>" target="_blank">Open file</a>

          <form action="/files/<%= stored_file.id %>/delete" method="post">
            <button class="danger" type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% end %>
  <% end %>
</section>
