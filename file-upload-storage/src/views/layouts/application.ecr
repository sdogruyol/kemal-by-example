<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>File Upload & Storage</title>
    <style>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f8fafc;
        color: #0f172a;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 32px 16px 48px;
      }

      .hero {
        background: linear-gradient(135deg, #2563eb, #0891b2);
        color: #fff;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
      }

      .card {
        background: #fff;
        border: 1px solid #dbe3ee;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
      }

      .stack > * + * {
        margin-top: 12px;
      }

      .notice {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 16px;
      }

      .error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 16px;
      }

      .meta {
        color: #64748b;
      }

      .files-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
      }

      .preview {
        display: block;
        width: 100%;
        max-height: 180px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
      }

      form {
        margin: 0;
      }

      input[type="file"] {
        width: 100%;
        font: inherit;
      }

      button,
      .button-link {
        display: inline-block;
        border: 0;
        border-radius: 10px;
        padding: 10px 14px;
        background: #2563eb;
        color: #fff;
        font: inherit;
        text-decoration: none;
        cursor: pointer;
      }

      .button-link.secondary {
        background: #64748b;
      }

      button.danger {
        background: #dc2626;
      }

      .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 16px;
      }
    </style>
  </head>
  <body>
    <main>
      <%= content %>
    </main>
  </body>
</html>
